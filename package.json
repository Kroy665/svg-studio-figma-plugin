{
  "name": "svg-studio-plugin",
  "version": "0.0.3",
  "description": "Production-grade Figma plugin for managing and inserting SVG assets with Prisma ORM and SQLite database",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "backup": "node scripts/backup-restore.js backup",
    "restore": "node scripts/backup-restore.js restore",
    "test": "jest --coverage"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "figma",
    "plugin",
    "svg",
    "assets",
    "sqlite"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "better-sqlite3": "^9.2.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^6.19.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
